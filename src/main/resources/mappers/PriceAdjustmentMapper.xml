<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yd.price.workflow.db.repository.PriceAdjustmentMapper">

    <resultMap id="PriceAdjustmentResultMap" type="com.yd.price.workflow.db.entity.PriceAdjustment">
        <id property="id" column="id"/>
        <result property="productId" column="product_id"/>
        <result property="type" column="type" javaType="com.yd.price.workflow.db.entity.PriceAdjustmentType"/>
        <result property="value" column="value"/>
        <result property="mode" column="mode" javaType="com.yd.price.workflow.db.entity.PriceAdjustmentMode"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <resultMap id="PriceAdjustmentView" type="com.yd.price.workflow.db.entity.view.PriceAdjustmentView">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="mode" javaType="com.yd.price.workflow.db.entity.PriceAdjustmentMode" typeHandler="com.yd.price.workflow.db.handler.EnumTypeHandler"/>
            <arg column="value" javaType="java.math.BigDecimal"/>
        </constructor>
    </resultMap>

    <insert id="create" parameterType="com.yd.price.workflow.db.entity.PriceAdjustment" keyProperty="id" useGeneratedKeys="true">
        insert into price_adjustment(product_id, type, value, mode, updated_at)
        values (#{productId},
                CAST(#{type} as price_adjustment_type),
                #{value},
                CAST(#{mode} as price_adjustment_mode),
                #{updatedAt})
        returning id;
    </insert>

    <select id="findAllByProductId" parameterType="long" resultMap="PriceAdjustmentResultMap">
        select id,
               product_id,
               type,
               mode,
               value,
               updated_at
        from price_adjustment
        where product_id = #{productId};
    </select>

</mapper>
