<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yd.price.workflow.persistence.repository.PriceAdjustmentMapper">

    <!-- Result mapping for PriceAdjustment entity -->
    <resultMap id="PriceAdjustmentResultMap" type="com.yd.price.workflow.persistence.entity.PriceAdjustment">
        <id property="id" column="id"/>
        <result property="productId" column="product_id"/>
        <result property="type" column="type" typeHandler="org.apache.ibatis.type.EnumTypeHandler" javaType="com.yd.price.workflow.persistence.entity.PriceAdjustmentType"/>
        <result property="value" column="value"/>
        <result property="mode" column="mode" typeHandler="org.apache.ibatis.type.EnumTypeHandler" javaType="com.yd.price.workflow.persistence.entity.PriceAdjustmentMode"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- Select all adjustments for a product -->
    <select id="findAll" parameterType="long" resultMap="PriceAdjustmentResultMap">
        SELECT id, product_id, type, value, mode, updated_at
        FROM price_adjustment
        ORDER BY updated_at DESC
    </select>

</mapper>
