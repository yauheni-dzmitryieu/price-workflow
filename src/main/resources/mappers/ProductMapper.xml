<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yd.price.workflow.db.repository.ProductMapper">

    <resultMap id="ProductBasePriceViewMap" type="com.yd.price.workflow.db.entity.view.ProductBasePriceView">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="base_price" javaType="java.math.BigDecimal"/>
        </constructor>
    </resultMap>

    <select id="findBasePriceByProductId" parameterType="long" resultMap="ProductBasePriceViewMap">
        select
            id,
            base_price
        from product
        where id = #{id}
    </select>
</mapper>